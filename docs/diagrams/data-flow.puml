@startuml
title Messenger - Data Flow Diagram

top to bottom direction


' External Entity
rectangle "Messenger User" as User

' Processes
usecase "1.0\nManage Accounts and Profiles" as P1
usecase "2.0\nManage Conversations" as P2
usecase "3.0\nProcess Messages" as P3
usecase "4.0\nRetrieve Message History" as P4
usecase "5.0\nDeliver Messages and Notifications" as P5


' Data Stores
database "D1\nUser Accounts and Profiles" as D1
database "D2\nMessages" as D2
database "D3\nConversations and Membership" as D3

' External Entity Data Flows

' Account and Profile Management
User --> P1 : Registration, login, and profile requests
P1 --> User : Account, session, and profile results

' Conversation Management
User --> P2 : Conversation and membership requests
P2 --> User : Conversation and membership results

' Message Processing
User --> P3 : Message submission or modification
P3 --> User : Message processing result

' Message History
User --> P4 : Conversation history request
P4 --> User : Authorized message history

' Real-Time Delivery and Notifications
P5 --> User : Real-time messages and notifications


' Internal Data Flows and Data Store Connections

' D1 - User Accounts and Profiles
P1 --> D1 : Account and profile updates
D1 --> P1 : Account and profile records

' D3 - Conversations and Membership
' P2 uses existing membership records to authorize protected
' conversation operations before applying updates.
P2 --> D3 : Conversation and membership updates
D3 --> P2 : Conversation and membership records


' D2 - Messages
P3 --> D2 : New and modified messages
D2 --> P3 : Message storage results

P4 --> D2 : Message history query
D2 --> P4 : Stored conversation messages

' Authentication and Authorization Dependencies
P1 --> P2 : Verified user identity
P1 --> P3 : Verified user identity
P1 --> P4 : Verified user identity
P1 --> P5 : Authenticated connection identity

D3 --> P3 : Conversation membership information
D3 --> P4 : History access membership information
D3 --> P5 : Conversation membership for delivery authorization

' Recipient Identification
D1 --> P2 : Registered user information

' Real-Time Delivery and Notifications
P3 --> P5 : Successfully stored message information



@enduml
